  "items": [
    {
      "id": "ssh.key",
      "title": "SSH private key",
      "why": "Logs in to every server and pushes to every Git host that trusts the key. Without a passphrase, the file alone is enough.",
      "level": "head",
      "head_bytes": 192,
      "paths": [
        {
          "base": "home",
          "glob": ".ssh"
        },
        {
          "base": "home",
          "glob": ".ssh/*"
        }
      ],
      "sources": [
        "openssh-ssh",
        "openssh-protocol-key"
      ]
    },
    {
      "id": "ssh.public",
      "title": "SSH public key",
      "why": "Public. Read to name the private key next to it by its type and fingerprint.",
      "level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".ssh/*.pub"
        }
      ],
      "sources": [
        "openssh-keygen"
      ]
    },
    {
      "id": "aws.credentials",
      "title": "AWS credentials file",
      "why": "Static access keys work from anywhere until someone rotates them.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".aws/credentials"
        },
        {
          "base": "env:AWS_SHARED_CREDENTIALS_FILE",
          "glob": "."
        }
      ],
      "sources": [
        "aws-files"
      ]
    },
    {
      "id": "aws.config",
      "title": "AWS config",
      "why": "Can hold access keys too, and names the roles and SSO sessions every profile can use.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".aws/config"
        },
        {
          "base": "env:AWS_CONFIG_FILE",
          "glob": "."
        }
      ],
      "sources": [
        "aws-files"
      ]
    },
    {
      "id": "aws.sso_cache",
      "title": "AWS cached session tokens",
      "why": "Short-lived, but valid for hours: enough to copy everything a role can read.",
      "level": "stat",
      "paths": [
        {
          "base": "home",
          "glob": ".aws/sso/cache"
        },
        {
          "base": "home",
          "glob": ".aws/cli/cache"
        }
      ],
      "sources": [
        "aws-sso"
      ]
    },
    {
      "id": "gcloud.credentials",
      "title": "Google Cloud CLI credentials",
      "why": "Refresh tokens for every account gcloud is signed in to; they do not expire on their own.",
      "level": "stat",
      "paths": [
        {
          "base": "gcloud",
          "glob": "credentials.db"
        },
        {
          "base": "gcloud",
          "glob": "access_tokens.db"
        },
        {
          "base": "gcloud",
          "glob": "legacy_credentials"
        }
      ],
      "sources": [
        "gcloud-config"
      ]
    },
    {
      "id": "gcloud.adc",
      "title": "Google application default credentials",
      "why": "Every Google client library on the machine uses this file: a refresh token or a service account key.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "gcloud",
          "glob": "application_default_credentials.json"
        }
      ],
      "sources": [
        "gcloud-adc"
      ]
    },
    {
      "id": "azure.tokens",
      "title": "Azure CLI tokens and service principal secrets",
      "why": "Signed-in sessions, and on Linux service principal secrets in plain JSON.",
      "level": "stat",
      "paths": [
        {
          "base": "azure",
          "glob": "msal_token_cache.*"
        },
        {
          "base": "azure",
          "glob": "accessTokens.json"
        },
        {
          "base": "azure",
          "glob": "service_principal_entries.*"
        }
      ],
      "sources": [
        "azure-cli"
      ]
    },
    {
      "id": "gh.hosts",
      "title": "GitHub CLI login",
      "why": "A GitHub token with the scopes you granted gh: push, create repositories, read private code. In the keyring, `gh auth token` still prints it to anyone running as you.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "gh",
          "glob": "hosts.yml"
        }
      ],
      "sources": [
        "gh-auth",
        "gh-env"
      ]
    },
    {
      "id": "git.credentials",
      "title": "Git credential store",
      "why": "Plain-text passwords and tokens for every Git host listed in it.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".git-credentials"
        },
        {
          "base": "xdg_config",
          "glob": "git/credentials"
        }
      ],
      "sources": [
        "git-credential-store"
      ]
    },
    {
      "id": "netrc",
      "title": "netrc passwords",
      "why": "Plain-text logins that curl, git and package managers use without asking.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".netrc"
        },
        {
          "base": "home",
          "glob": "_netrc"
        },
        {
          "base": "env:NETRC",
          "glob": "."
        }
      ],
      "sources": [
        "curl-netrc"
      ]
    },
    {
      "id": "npm.token",
      "title": "npm token",
      "why": "Publishes packages under your name: a supply-chain attack waiting for one command.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".npmrc"
        },
        {
          "base": "env:NPM_CONFIG_USERCONFIG",
          "glob": "."
        },
        {
          "base": "workspace",
          "glob": ".npmrc"
        }
      ],
      "sources": [
        "npmrc"
      ]
    },
    {
      "id": "pypi.token",
      "title": "PyPI token",
      "why": "Publishes packages under your name.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".pypirc"
        }
      ],
      "sources": [
        "pypirc"
      ]
    },
    {
      "id": "cargo.token",
      "title": "Cargo registry token",
      "why": "Publishes crates under your name.",
      "level": "stat",
      "paths": [
        {
          "base": "cargo",
          "glob": "credentials.toml"
        },
        {
          "base": "cargo",
          "glob": "credentials"
        }
      ],
      "sources": [
