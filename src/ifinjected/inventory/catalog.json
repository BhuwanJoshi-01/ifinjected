      ]
    },
    {
      "id": "docker.config",
      "title": "Docker registry logins",
      "why": "Without a credential store, registry passwords sit in config.json, base64-encoded: push images as you.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "docker",
          "glob": "config.json"
        }
      ],
      "sources": [
        "docker-config"
      ]
    },
    {
      "id": "kube.config",
      "title": "Kubernetes config",
      "why": "Cluster access with your rights, often cluster-admin on development clusters.",
      "level": "stat",
      "deep_level": "full",
      "paths": [
        {
          "base": "home",
          "glob": ".kube/config"
        },
        {
          "base": "kubeconfig",
          "glob": "."
        }
      ],
      "sources": [
        "kubeconfig"
      ]
    }
  ]
