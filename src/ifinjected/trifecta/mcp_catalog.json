      "id": "filesystem",
      "title": "Filesystem",
      "match": {
        "packages": [
          "@modelcontextprotocol/server-filesystem"
        ]
      },
      "capabilities": [
        "reads_files",
        "writes_files"
      ],
      "source": "https://github.com/modelcontextprotocol/servers",
      "note": "Reads and writes files in the directories it is given, outside any agent sandbox."
    },
    {
